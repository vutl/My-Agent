APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=7777
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=cx/gpt-5.6-sol
VISION_PROVIDER=openai_compatible
VISION_MODEL=cx/gpt-5.6-sol
EMBEDDING_MODEL=embeddinggemma:300m
EMBEDDING_DIM=768
EMBEDDING_MAX_TOKEN_SIZE=2048
EMBEDDING_QUERY_PREFIX="task: search result | query: "
EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
# Hybrid RRF is the measured fast path. Enable only after configuring and
# benchmarking an explicit local cross-encoder model.
RERANK_ENABLED=false
# embedding is the zero-download baseline. Switch only after downloading and
# benchmarking a local sequence-classification model.
RERANK_MODE=cross_encoder
# RERANK_CROSS_ENCODER_PATH=/absolute/path/to/local/cross-encoder
RERANK_MAX_CANDIDATES=20
AGENTIC_RETRIEVAL_DECOMPOSITION_ENABLED=true
AGENTIC_RETRIEVAL_MAX_HOPS=2
AGENTIC_RETRIEVAL_MAX_SUBQUERIES=3
AGENTIC_RETRIEVAL_HOP_TIMEOUT_SECONDS=45
# auto: focused/direct QA -> fast hybrid; discovery/cross-paper -> LightRAG.
RETRIEVAL_ENGINE=auto
REQUEST_TIMEOUT_SECONDS=120
CONDA_ENV_NAME=react-langchain

# --- LLM Provider (OAuth qua 9router, KHÔNG dùng OpenRouter/API key trực tiếp) ---
# "ollama"             : dùng Ollama local
# "openai_compatible"  : proxy tới 9router local (OpenAI-compatible surface)
LLM_PROVIDER=openai_compatible
ROUTER_MODEL=cx/gpt-5.6-sol
ROUTER_LLM_PROVIDER=openai_compatible

# 9router = đăng nhập subscription/OAuth trong dashboard, KHÔNG phải API key billing
# 1. npm install -g 9router && 9router
# 2. Mở http://localhost:20128 → Providers → Connect
#    - cx/*  : Codex / Cursor subscription (OAuth)
#    - cc/*  : Claude Code subscription (OAuth) — giống lần trước
#    - ag/*  : Antigravity free (OAuth)
# 3. OPENAI_API_KEY có thể để "any" — 9router local không dùng key thật
OPENAI_API_BASE=http://localhost:20128/v1
OPENAI_API_KEY=any

# Model id lấy từ 9router dashboard (prefix = provider OAuth):
#   cx/gpt-5.6-sol          Default/recommended
#   cx/gpt-5.6-terra        Manual alternative
#   cx/gpt-5.6-luna         Manual alternative
#   cc/claude-sonnet-4-6    Claude Code OAuth
# DEFAULT_MODEL=cx/gpt-5.6-sol

# --- LightRAG graph index (entity/relation extraction) ---
# Dùng Codex qua 9router — KHÔNG dùng qwen local cho ainsert
LIGHTRAG_ENABLED=true
LIGHTRAG_LLM_MODEL=cx/gpt-5.6-sol
# Intentionally empty: do not hide quota/provider errors by switching models.
LIGHTRAG_LLM_FALLBACK_MODELS=
# Serialize large Sol extraction calls to avoid saturating the local gateway.
LIGHTRAG_LLM_MAX_ASYNC=1
# One same-model retry for transient timeout/connection errors; quota still fails fast.
LIGHTRAG_LLM_TIMEOUT_RETRIES=1
# Bound dense table/entity extraction prompts; overlap must stay below size.
LIGHTRAG_CHUNK_TOKEN_SIZE=600
LIGHTRAG_CHUNK_OVERLAP_TOKEN_SIZE=80
# Timeout riêng cho graph extract (PDF nặng cần 300s+; LightRAG worker mặc định 240s)
LIGHTRAG_LLM_TIMEOUT_SECONDS=300
# LIGHTRAG_LLM_API_BASE=http://localhost:20128/v1
# LIGHTRAG_LLM_API_KEY=any
# RETRIEVAL_ENGINE=auto       # auto | lightrag | legacy | dual

# Background memory consolidation: never blocks the answer path. Quick turns
# inside this idle window are coalesced into one cx/gpt-5.6-sol request.
MEMORY_FOLD_DEBOUNCE_SECONDS=12
MEMORY_WORKER_SHUTDOWN_TIMEOUT_SECONDS=3

# Opt-in diagnostic trace: both this server gate and request.debug_trace=true
# are required. Redacted traces are loopback-only, capped and automatically purged.
AGENT_DEBUG_TRACE_ENABLED=false
AGENT_DEBUG_TRACE_MAX_BYTES=65536
AGENT_DEBUG_TRACE_RETENTION_HOURS=72
AGENT_DEBUG_TRACE_MAX_RUNS=25

# Offline provenance-backed evidence-card pipeline. Build and runtime have
# separate gates so a corpus can be backfilled/audited before card-first QA is enabled.
PAPER_EVIDENCE_CARDS_ENABLED=false
PAPER_EVIDENCE_CARD_BUILD_ENABLED=false
PAPER_EVIDENCE_CARD_MODEL=cx/gpt-5.6-sol
PAPER_EVIDENCE_CARD_MAX_CONCURRENCY=2
PAPER_EVIDENCE_CARD_SCHEMA_VERSION=v1
PAPER_EVIDENCE_CARD_PROMPT_VERSION=v2
PAPER_SECTION_STREAMING_ENABLED=false

# Embedding luôn chạy local qua Ollama (9router không handle embeddings).
# Production index hiện khớp EmbeddingGemma; đổi model/prefix phải rebuild cả
# LanceDB và ba LightRAG vector store, không chỉ sửa env.

# Optional: pip install pyvi  (cải thiện FTS tiếng Việt)
